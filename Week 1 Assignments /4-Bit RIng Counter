module #(parameter WIDTH=4)(input clk ,input rst,output reg [WIDTH-1:0]out); // Defining the output ,input signals and parameter
always @(posedge clk) // Using a synchronous reset
begin
if(rst) //Resetting the output based on rst(Active high) signal
out<=4'b1110;
else
begin
out[0]<=out[WIDTH-1];             //Shifting the rightmost bit to the leftmost bit , this acts as a ring joint
for(int i=WIDTH-1;i>0;i=i-1)      // Loop to shift each bit in the 4 bit number
begin
out[i]<=out[i-1];
end
end
end
endmodule
